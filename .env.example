# העתק קובץ זה ל-.env ומלא את הערכים האמיתיים
# משתנים שמסומנים ב-REQUIRED חייבים להיות מוגדרים בפרודקשן

# [REQUIRED] מסד נתונים
DATABASE_URL=sqlite:///./jachnun.db
# בפרודקשן (Render):
# DATABASE_URL=postgresql://user:password@host/dbname

# [REQUIRED] Twilio
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886

# [REQUIRED בפרודקשן] מספרי גבריאל
GABRIEL_PHONE=whatsapp:+972539475881
GABRIEL_PAYMENT_PHONE=054-2380330

# [OPTIONAL] Render keep-alive — מנע שינת השרת
RENDER_EXTERNAL_URL=https://your-app.onrender.com

# [OPTIONAL] פרטי כניסה לדשבורד (ברירות מחדל כמו למטה)
ADMIN_USERNAME=גבריאל
ADMIN_PASSWORD=גבריאל123
